# Data - never commit raw samples or processed artifacts
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models - large binaries belong in releases, not the repo
models/*.pt
models/*.pkl
models/*.joblib
models/*.bin
models/*.safetensors

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

