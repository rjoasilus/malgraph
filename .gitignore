# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_convert.*

# Data - never commit raw samples or per-sample processed artifacts.
# Whitelist the aggregate manifest and schema-version marker as
# evidence that Sprint 1 exit criteria were met.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/manifest.jsonl
!data/processed/_schema_version.txt

# Models - large binaries belong in releases, not the repo
models/*.pt
models/*.pkl
models/*.joblib
models/*.bin
models/*.safetensors

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets
.env
*.key

